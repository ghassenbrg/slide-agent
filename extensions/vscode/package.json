{
  "name": "slide-agent-vscode",
  "displayName": "Slide Agent",
  "description": "Create, edit, render, and validate distinctive editable PowerPoint presentations with any AI model.",
  "version": "0.14.0",
  "publisher": "ghassenbrg",
  "license": "MIT",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/ghassenbrg/slide-agent.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other",
    "Machine Learning"
  ],
  "keywords": [
    "PowerPoint",
    "PPTX",
    "slides",
    "presentation",
    "AI",
    "Copilot",
    "Claude",
    "Codex",
    "Gemini"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "slideAgent.start",
        "title": "Slide Agent: Start",
        "icon": "$(file-media)"
      },
      {
        "command": "slideAgent.install",
        "title": "Slide Agent: Install or Update"
      },
      {
        "command": "slideAgent.create",
        "title": "Slide Agent: Create Presentation"
      },
      {
        "command": "slideAgent.createFromCurrentFile",
        "title": "Slide Agent: Create from Current Brief"
      },
      {
        "command": "slideAgent.edit",
        "title": "Slide Agent: Edit Existing Presentation"
      },
      {
        "command": "slideAgent.doctor",
        "title": "Slide Agent: Check Installation"
      },
      {
        "command": "slideAgent.walkthrough",
        "title": "Slide Agent: Open Getting Started"
      }
    ],
    "configuration": {
      "title": "Slide Agent",
      "properties": {
        "slideAgent.cliPath": {
          "type": "string",
          "default": "",
          "description": "Optional custom path to the Slide Agent CLI. When empty, the extension uses the managed launcher under ~/.local/bin."
        },
        "slideAgent.autoInstall": {
          "type": "boolean",
          "default": true,
          "description": "Automatically install or update the matching Slide Agent engine and agent skills once per extension version."
        },
        "slideAgent.defaultOutputDirectory": {
          "type": "string",
          "default": "output",
          "description": "Workspace-relative directory used by the save dialog."
        },
        "slideAgent.openAfterCreate": {
          "type": "boolean",
          "default": true,
          "description": "Open the generated PowerPoint with the operating system after successful creation."
        }
      }
    },
    "menus": {
      "editor/title": [
        {
          "command": "slideAgent.createFromCurrentFile",
          "when": "resourceExtname == .md || resourceExtname == .txt || resourceExtname == .json || resourceExtname == .ndjson",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "slideAgent.walkthrough",
          "when": "true"
        }
      ]
    },
    "walkthroughs": [
      {
        "id": "slideAgent.gettingStarted",
        "title": "Get started with Slide Agent",
        "description": "Describe a presentation, get an editable PowerPoint file.",
        "steps": [
          {
            "id": "slideAgent.step.install",
            "title": "Set it up (one minute)",
            "description": "Everything installs in your own user folder. Node.js 22.12+ is the only prerequisite.\n[Set up Slide Agent](command:slideAgent.install)",
            "media": {
              "markdown": "media/walkthrough/install.md"
            },
            "completionEvents": [
              "onCommand:slideAgent.install"
            ]
          },
          {
            "id": "slideAgent.step.create",
            "title": "Describe your first deck",
            "description": "Say who it is for and what you want them to do. The AI model handles the design.\n[Create a presentation](command:slideAgent.create)",
            "media": {
              "markdown": "media/walkthrough/create.md"
            },
            "completionEvents": [
              "onCommand:slideAgent.create",
              "onCommand:slideAgent.createFromCurrentFile"
            ]
          },
          {
            "id": "slideAgent.step.chat",
            "title": "Use it from your AI chats",
            "description": "Copilot, Claude Code, and Codex can build decks too, once setup is done.",
            "media": {
              "markdown": "media/walkthrough/chat.md"
            }
          },
          {
            "id": "slideAgent.step.doctor",
            "title": "Confirm it works",
            "description": "Builds a real test deck, so a broken setup reports itself.\n[Check installation](command:slideAgent.doctor)",
            "media": {
              "markdown": "media/walkthrough/doctor.md"
            },
            "completionEvents": [
              "onCommand:slideAgent.doctor"
            ]
          }
        ]
      }
    ]
  },
  "scripts": {
    "compile": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "check": "tsc --noEmit",
    "package": "npm run check && npm run compile && vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.1",
    "typescript": "^7.0.2"
  }
}
