{
  "name": "slide-agent-vscode",
  "displayName": "Slide Agent",
  "description": "Create, edit, render, and validate distinctive editable PowerPoint presentations with any AI model.",
  "version": "0.0.1",
  "publisher": "ghassenbrg",
  "license": "MIT",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/ghassenbrg/slide-agent.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other",
    "Machine Learning"
  ],
  "keywords": [
    "PowerPoint",
    "PPTX",
    "slides",
    "presentation",
    "AI",
    "Copilot",
    "Claude",
    "Codex",
    "Gemini"
  ],
  "activationEvents": [
    "onCommand:slideAgent.install",
    "onCommand:slideAgent.create",
    "onCommand:slideAgent.createFromCurrentFile",
    "onCommand:slideAgent.edit",
    "onCommand:slideAgent.doctor"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "slideAgent.install",
        "title": "Slide Agent: Install or Update"
      },
      {
        "command": "slideAgent.create",
        "title": "Slide Agent: Create Presentation"
      },
      {
        "command": "slideAgent.createFromCurrentFile",
        "title": "Slide Agent: Create from Current Brief"
      },
      {
        "command": "slideAgent.edit",
        "title": "Slide Agent: Edit Existing Presentation"
      },
      {
        "command": "slideAgent.doctor",
        "title": "Slide Agent: Check Installation"
      }
    ],
    "configuration": {
      "title": "Slide Agent",
      "properties": {
        "slideAgent.cliPath": {
          "type": "string",
          "default": "slide-agent",
          "description": "Path to the Slide Agent CLI."
        },
        "slideAgent.defaultOutputDirectory": {
          "type": "string",
          "default": "output",
          "description": "Workspace-relative directory used by the save dialog."
        },
        "slideAgent.openAfterCreate": {
          "type": "boolean",
          "default": true,
          "description": "Open the generated PowerPoint with the operating system after successful creation."
        }
      }
    },
    "menus": {
      "editor/title": [
        {
          "command": "slideAgent.createFromCurrentFile",
          "when": "resourceExtname == .md || resourceExtname == .txt || resourceExtname == .json || resourceExtname == .ndjson",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "compile": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "check": "tsc --noEmit",
    "package": "npm run check && npm run compile && vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.1",
    "typescript": "^5.9.3"
  }
}
