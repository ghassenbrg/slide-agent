{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "slideId": {
      "type": "string",
      "minLength": 1
    },
    "narrativeJob": {
      "type": "string",
      "minLength": 1,
      "description": "What this slide has to accomplish for the audience."
    },
    "dominantArtifact": {
      "$ref": "#/$defs/__schema2"
    },
    "silhouette": {
      "$ref": "#/$defs/__schema4"
    },
    "energy": {
      "$ref": "#/$defs/__schema6"
    },
    "transition": {
      "type": "string"
    }
  },
  "required": [
    "slideId",
    "narrativeJob"
  ],
  "additionalProperties": {},
  "description": "One slide's declared job and intended silhouette. Later critique compares the render against this.",
  "$defs": {
    "__schema2": {
      "type": "string"
    },
    "__schema4": {
      "type": "string"
    },
    "__schema6": {
      "type": "string"
    }
  }
}
