{"kind":"textbox","slide":6,"id":"targetlabel","bbox":[9.7,4.8,2.4,0.4],"role":"eyebrow","text":"TARGET RTO","style":{"fontSize":12,"color":"8B98A5","fontFace":"Consolas","align":"center"}}
{"kind":"notes","slide":6,"notes":["Close by naming what happens next, not by thanking the room."]}
