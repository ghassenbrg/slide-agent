{"kind":"diagram","slide":2,"id":"d2","grammar":"layered","bbox":[0.8,1.8,11.7,4.6],"spec":{"flow":true,"layers":[{"label":"ingress","items":["pgbouncer-a","pgbouncer-b"]},{"label":"primary","items":["db-primary (us-east-1a)"],"emphasis":true},{"label":"standby","items":["db-standby (us-east-1b)","db-standby (us-west-2a)"]}]}}
{"kind":"notes","slide":2,"notes":["Only the ingress layer is reconfigured. The standbys are already streaming."]}
{"kind":"slide","slide":3,"freeform":true,"id":"sequence","semanticKind":"sequence","title":"The eight-minute path","background":"0B0E14"}
{"kind":"textbox","slide":3,"id":"t3","bbox":[0.8,0.6,11.7,0.7],"role":"title","text":"The eight-minute path","style":{"fontSize":32,"color":"E6EDF3","bold":true,"fontFace":"Consolas"}}
{"kind":"diagram","slide":3,"id":"d3","grammar":"sequence","bbox":[0.8,1.8,11.7,4.6],"spec":{"actors":["on-call","pgbouncer","standby","monitoring"],"messages":[{"from":"on-call","to":"pgbouncer","label":"PAUSE app_prod"},{"from":"on-call","to":"standby","label":"pg_ctl promote"},{"from":"standby","to":"on-call","label":"promoted","dashed":true},{"from":"on-call","to":"pgbouncer","label":"repoint + RESUME"},{"from":"monitoring","to":"on-call","label":"write latency normal","dashed":true}]}}
{"kind":"slide","slide":4,"freeform":true,"id":"commands","semanticKind":"reference","title":"The commands, in order","background":"0B0E14"}
{"kind":"textbox","slide":4,"id":"t4","bbox":[0.8,0.6,11.7,0.7],"role":"title","text":"The commands, in order","style":{"fontSize":32,"color":"E6EDF3","bold":true,"fontFace":"Consolas"}}
{"kind":"shape","slide":4,"id":"term","bbox":[0.8,1.7,11.7,4.7],"role":"panel","style":{"fill":"141922","lineColor":"21262D","lineWidth":1}}
{"kind":"textbox","slide":4,"id":"code","bbox":[1.1,2.0,11.1,4.1],"role":"body","style":{"fontSize":16,"color":"E6EDF3","fontFace":"Consolas"},"runs":[{"text":"# 1. stop accepting new writes — clients queue, they do not error\n","options":{"color":"8B98A5"}},{"text":"psql -h pgbouncer -p 6432 pgbouncer -c \"PAUSE app_prod;\"\n\n"},{"text":"# 2. promote the closest standby\n","options":{"color":"8B98A5"}},{"text":"ssh db-standby-1a \"pg_ctl promote -D /var/lib/postgresql/data\"\n\n"},{"text":"# 3. confirm it accepts writes BEFORE redirecting anything\n","options":{"color":"D29922"}},{"text":"psql -h db-standby-1a -c \"SELECT pg_is_in_recovery();\"   # expect f\n\n"},{"text":"# 4. repoint and resume\n","options":{"color":"8B98A5"}},{"text":"ansible-playbook pgbouncer-repoint.yml -e target=db-standby-1a\n"},{"text":"psql -h pgbouncer -p 6432 pgbouncer -c \"RESUME app_prod;\"\n"}]}
{"kind":"notes","slide":4,"notes":["Step 3 is the one people skip under pressure. Do not skip step 3."]}
{"kind":"slide","slide":5,"freeform":true,"id":"checks","semanticKind":"table","title":"Verify before you stand down","background":"0B0E14"}
{"kind":"textbox","slide":5,"id":"t5","bbox":[0.8,0.6,11.7,0.7],"role":"title","text":"Verify before you stand down","style":{"fontSize":32,"color":"E6EDF3","bold":true,"fontFace":"Consolas"}}
{"kind":"table","slide":5,"id":"tbl","bbox":[0.8,1.8,11.7,3.4],"table":{"headers":["Check","How","Expected"],"rows":[["Writes landing","count rows created in the last minute","greater than zero"],["Replication","SELECT * FROM pg_stat_replication","2 rows, state = streaming"],["Connection pool","SHOW POOLS","cl_waiting = 0"],["Error rate","curl -s metrics/5xx","below 0.1%"]]}}
{"kind":"textbox","slide":5,"id":"warn","bbox":[0.8,5.5,11.7,0.8],"role":"body","text":"If any check fails, do not roll back. Page the database on-call — a split brain is worse than a slow failover.","style":{"fontSize":17,"color":"D29922","fontFace":"Consolas"}}
{"kind":"slide","slide":6,"freeform":true,"id":"after","semanticKind":"closing","title":"After the incident","background":"0B0E14"}
{"kind":"textbox","slide":6,"id":"t6","bbox":[0.8,1.6,8.4,1.2],"role":"title","text":"After the incident","style":{"fontSize":44,"color":"E6EDF3","bold":true,"fontFace":"Consolas"}}
{"kind":"textbox","slide":6,"id":"a1","bbox":[0.8,3.2,7.6,2.4],"role":"body","text":"1.  Rebuild the old primary as a standby before you sleep.\n2.  Write the timeline while you still remember it.\n3.  If step 3 failed, fix the runbook — not the engineer.","style":{"fontSize":19,"color":"8B98A5","fontFace":"Consolas"}}
