{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "kind": {
      "type": "string",
      "enum": [
        "bar",
        "bar-stacked",
        "bar-horizontal",
        "line",
        "pie",
        "doughnut",
        "area",
        "scatter",
        "radar",
        "waterfall"
      ],
      "description": "A native, editable chart. `scatter` reads its labels as x values. For anything else PptxGenJS can draw, use a native-chart element."
    },
    "labels": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Category labels, one per value in every series. For a scatter chart these are the x values and must be numbers."
    },
    "series": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "values": {
            "type": "array",
            "items": {
              "type": "number"
            }
          }
        },
        "required": [
          "name",
          "values"
        ]
      }
    },
    "unit": {
      "type": "string"
    },
    "showLegend": {
      "type": "boolean"
    },
    "showValues": {
      "type": "boolean"
    }
  },
  "required": [
    "kind",
    "labels",
    "series"
  ]
}
