{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "type": "string",
      "minLength": 1,
      "description": "Any semantic label. Metadata, not a whitelist."
    },
    "layout": {
      "description": "A registered fallback layout. Ignored when canvas is present.",
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "subtitle": {
      "type": "string"
    },
    "sectionLabel": {
      "type": "string"
    },
    "body": {
      "type": "string"
    },
    "bullets": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "visual": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "alt": {
          "type": "string",
          "minLength": 1
        },
        "caption": {
          "type": "string"
        },
        "position": {
          "type": "string",
          "enum": [
            "left",
            "right",
            "full"
          ]
        }
      },
      "required": [
        "alt"
      ]
    },
    "comparison": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "heading": {
            "type": "string"
          },
          "points": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "emphasis": {
            "type": "boolean"
          }
        },
        "required": [
          "heading",
          "points"
        ]
      }
    },
    "timeline": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          }
        },
        "required": [
          "label",
          "title"
        ]
      }
    },
    "process": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          },
          "owner": {
            "type": "string"
          }
        },
        "required": [
          "title"
        ]
      }
    },
    "architecture": {
      "type": "object",
      "properties": {
        "nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "group": {
                "type": "string"
              },
              "emphasis": {
                "type": "boolean"
              }
            },
            "required": [
              "id",
              "label"
            ]
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "from": {
                "type": "string"
              },
              "to": {
                "type": "string"
              },
              "label": {
                "type": "string"
              }
            },
            "required": [
              "from",
              "to"
            ]
          }
        },
        "direction": {
          "type": "string",
          "enum": [
            "horizontal",
            "vertical"
          ]
        }
      },
      "required": [
        "nodes",
        "edges"
      ]
    },
    "table": {
      "type": "object",
      "properties": {
        "headers": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "number"
                }
              ]
            }
          }
        },
        "columnWidths": {
          "type": "array",
          "items": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "highlightRows": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        }
      },
      "required": [
        "headers",
        "rows"
      ]
    },
    "chart": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "bar",
            "bar-stacked",
            "bar-horizontal",
            "line",
            "pie",
            "doughnut",
            "area",
            "scatter",
            "radar",
            "waterfall"
          ],
          "description": "A native, editable chart. `scatter` reads its labels as x values. For anything else PptxGenJS can draw, use a native-chart element."
        },
        "labels": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Category labels, one per value in every series. For a scatter chart these are the x values and must be numbers."
        },
        "series": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "values": {
                "type": "array",
                "items": {
                  "type": "number"
                }
              }
            },
            "required": [
              "name",
              "values"
            ]
          }
        },
        "unit": {
          "type": "string"
        },
        "showLegend": {
          "type": "boolean"
        },
        "showValues": {
          "type": "boolean"
        }
      },
      "required": [
        "kind",
        "labels",
        "series"
      ]
    },
    "kpis": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "value": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          },
          "trend": {
            "type": "string",
            "enum": [
              "up",
              "down",
              "flat"
            ]
          }
        },
        "required": [
          "label",
          "value"
        ]
      }
    },
    "quote": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string"
        },
        "attribution": {
          "type": "string"
        }
      },
      "required": [
        "text"
