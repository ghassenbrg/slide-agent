    "custom": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "x": {
            "type": "number",
            "description": "Inches on the slide canvas."
          },
          "y": {
            "type": "number",
            "description": "Inches on the slide canvas."
          },
          "w": {
            "type": "number",
            "description": "Inches on the slide canvas."
          },
          "h": {
            "type": "number",
            "description": "Inches on the slide canvas."
          },
          "type": {
            "type": "string",
