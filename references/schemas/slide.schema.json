          "text": {
            "type": "string"
          },
          "imagePath": {
            "type": "string"
          },
          "fill": {
            "type": "string",
            "pattern": "^#?(?:[0-9A-Fa-f]{3}|[0-9A-Fa-f]{6})$",
            "description": "Hex color, with or without a leading #."
          },
          "fontSize": {
            "type": "number",
            "exclusiveMinimum": 0
