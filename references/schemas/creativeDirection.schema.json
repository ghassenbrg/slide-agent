{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "concept": {
      "type": "string"
    },
    "rationale": {
      "type": "string"
    },
    "mood": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "palette": {
      "type": "object",
      "properties": {
        "background": {
          "type": "string",
          "pattern": "^#?(?:[0-9A-Fa-f]{3}|[0-9A-Fa-f]{6})$",
          "description": "Hex color, with or without a leading #."
        },
        "surface": {
          "type": "string",
          "pattern": "^#?(?:[0-9A-Fa-f]{3}|[0-9A-Fa-f]{6})$",
          "description": "Hex color, with or without a leading #."
        },
        "ink": {
          "type": "string",
          "pattern": "^#?(?:[0-9A-Fa-f]{3}|[0-9A-Fa-f]{6})$",
          "description": "Hex color, with or without a leading #."
        },
        "muted": {
          "type": "string",
          "pattern": "^#?(?:[0-9A-Fa-f]{3}|[0-9A-Fa-f]{6})$",
          "description": "Hex color, with or without a leading #."
        },
        "accent": {
          "type": "string",
          "pattern": "^#?(?:[0-9A-Fa-f]{3}|[0-9A-Fa-f]{6})$",
          "description": "Hex color, with or without a leading #."
        },
        "accentAlt": {
          "type": "string",
          "pattern": "^#?(?:[0-9A-Fa-f]{3}|[0-9A-Fa-f]{6})$",
          "description": "Hex color, with or without a leading #."
        },
        "accentSoft": {
          "type": "string",
          "pattern": "^#?(?:[0-9A-Fa-f]{3}|[0-9A-Fa-f]{6})$",
          "description": "Hex color, with or without a leading #."
        },
        "rule": {
          "type": "string",
          "pattern": "^#?(?:[0-9A-Fa-f]{3}|[0-9A-Fa-f]{6})$",
          "description": "Hex color, with or without a leading #."
        },
        "positive": {
          "type": "string",
          "pattern": "^#?(?:[0-9A-Fa-f]{3}|[0-9A-Fa-f]{6})$",
          "description": "Hex color, with or without a leading #."
        },
        "negative": {
          "type": "string",
          "pattern": "^#?(?:[0-9A-Fa-f]{3}|[0-9A-Fa-f]{6})$",
          "description": "Hex color, with or without a leading #."
        },
        "warning": {
          "type": "string",
          "pattern": "^#?(?:[0-9A-Fa-f]{3}|[0-9A-Fa-f]{6})$",
          "description": "Hex color, with or without a leading #."
        },
        "colors": {
          "description": "Additional unnamed colors, in priority order.",
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^#?(?:[0-9A-Fa-f]{3}|[0-9A-Fa-f]{6})$",
            "description": "Hex color, with or without a leading #."
          }
        },
        "custom": {
          "description": "Named colors specific to this deck.",
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string",
            "pattern": "^#?(?:[0-9A-Fa-f]{3}|[0-9A-Fa-f]{6})$",
            "description": "Hex color, with or without a leading #."
          }
        }
      },
      "additionalProperties": {}
    },
    "typography": {
      "type": "object",
      "properties": {
        "display": {
          "type": "string"
        },
        "heading": {
          "type": "string"
        },
        "body": {
          "type": "string"
        },
        "mono": {
          "type": "string"
        },
        "numeric": {
          "type": "string"
        },
        "fallbacks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": {}
    },
    "visualSystem": {
      "type": "object",
      "properties": {
        "variables": {
          "description": "Arbitrary named values. Reference one from any style property with {\"$var\":\"name\"}.",
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        },
        "styles": {
          "description": "Arbitrary reusable style names. Reference them from an element with `styleRef`.",
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "basedOn": {
                "description": "Other style names, merged in order before this style's own values.",
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "style": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {},
                "description": "Element style properties. Same shape as an element's own `style`."
              }
            },
            "required": [
              "style"
            ],
            "additionalProperties": {}
          }
        },
        "motifs": {
          "description": "Subject-derived visual ideas and what they mean. Planning metadata; nothing is rendered from these.",
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "description": {
                "type": "string"
              },
              "meaning": {
                "type": "string"
              },
              "usage": {
                "type": "string"
              },
              "avoid": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "description"
            ],
            "additionalProperties": {}
          }
        },
        "constraints": {
          "description": "The author's own rules, not engine presets.",
          "type": "object",
          "properties": {
            "hard": {
              "description": "Rules this deck must not break.",
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "soft": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": {}
        }
      },
      "additionalProperties": {},
      "description": "The deck's own variables, named styles, motifs, and rules. Names are arbitrary; Slide Agent reserves none."
    },
    "compositionPrinciples": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "visualLanguage": {
      "type": "string"
    },
    "imageLanguage": {
      "type": "string"
    },
    "diagramLanguage": {
      "type": "string"
    },
    "chartLanguage": {
      "type": "string"
    },
    "shapeLanguage": {
      "type": "string"
    },
    "textureLanguage": {
      "type": "string"
    },
    "motionOrPacing": {
      "type": "string"
    },
    "geometryLanguage": {
      "description": "Open prose about corner language, edges, and shape. Never reduced to an enum.",
      "type": "string"
    },
    "spatialRhythm": {
      "description": "Open prose about spacing, pacing, and how the sequence breathes.",
      "type": "string"
    },
    "materialLanguage": {
      "description": "Open prose about surface, texture, grain, and material treatment.",
      "type": "string"
    },
    "density": {
      "description": "Legacy hint for the fallback layouts only. Deprecated in contract 0.10 — use spatialRhythm.",
      "type": "string",
      "enum": [
        "sparse",
        "balanced",
        "dense"
      ]
    },
    "geometry": {
      "description": "Legacy hint for the fallback layouts only. Deprecated in contract 0.10 — use geometryLanguage. Omitting it leaves shape language entirely to you.",
      "type": "string",
      "enum": [
        "sharp",
        "soft",
        "organic"
      ]
    },
    "avoid": {
      "description": "Deliberate exclusions. The renderer honours these.",
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": {},
  "description": "The deck's visual thesis. Open-ended: add fields that help the model reason.",
  "$defs": {
    "__schema0": {
      "description": "Any JSON value. Deck variables are deliberately this open.",
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        }
      ]
    }
  }
}
